{
  "name": "Airflow 3 Class",

  // Ready-made Linux + Python 3.12. Airflow 3.3.2 supports 3.10-3.12;
  // the constraints file in setup.sh must match this Python version.
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Runs ONCE, right after the codespace is built. Students wait, then it works.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Plain literal values only. Variable substitution such as
  // ${containerWorkspaceFolder} or ${containerEnv:PATH} is NOT reliable here -
  // an unresolvable one aborts container creation and drops you into recovery
  // mode. /workspaces/airflow-class is fixed by the repo name, so hardcode it.
  "containerEnv": {
    // Airflow's own state (db, config, logs). Gitignored.
    "AIRFLOW_HOME": "/workspaces/airflow-class/.airflow",

    // Without this, Airflow looks in ~/airflow/dags and your DAGs never appear.
    "AIRFLOW__CORE__DAGS_FOLDER": "/workspaces/airflow-class/dags",

    // Only the class's DAGs in the UI. Flip to true for the 50 built-in examples.
    "AIRFLOW__CORE__LOAD_EXAMPLES": "false",

    // Pick up an edited DAG in ~5s instead of the default 30s. Nice in a live
    // demo, wasteful on a real cluster.
    "AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL": "5"
  },

  // The Airflow UI. Codespaces shows an "open in browser" toast when it starts.
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Airflow UI",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
